# --- Général ---
NODE_ENV=development
PORT=3000
# URL publique de l'API (liens, webhooks Twilio)
PUBLIC_URL=http://localhost:3000
# Origines autorisées (admin web), séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# --- Données ---
DATABASE_URL=postgresql://hb:hb@localhost:5432/hb
REDIS_URL=redis://localhost:6379

# --- Sécurité (à changer impérativement en production) ---
# Secret de signature des jetons JWT (64 caractères aléatoires minimum)
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me-change-me-1234
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Tolérance (s) pour deux rafraîchissements simultanés du même jeton (plusieurs onglets)
REFRESH_REUSE_GRACE_SECONDS=10
# Clé AES-256 en base64 (32 octets) pour chiffrer les secrets 2FA :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
THROTTLE_LIMIT_PER_MINUTE=120
AUTH_THROTTLE_LIMIT_PER_MINUTE=10

# --- Fournisseurs externes : "console" en développement (tout est journalisé) ---
SMS_PROVIDER=console
TELEPHONY_PROVIDER=console
PUSH_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EXPO_ACCESS_TOKEN=

# Itinéraires : osrm (dans les rues, accès internet requis), ors (OpenRouteService, clé requise)
# ou straight (lignes droites, hors ligne). Le serveur OSRM public de FOSSGIS est à usage modéré :
# en production, hébergez votre propre OSRM ou utilisez ORS.
ROUTING_PROVIDER=osrm
# Serveur OSRM ; {profile} y est remplacé par foot, bike ou car (un serveur par profil)
OSRM_URL=https://routing.openstreetmap.de
ORS_API_KEY=

# Pièces justificatives : local ou s3
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=eu-west-3
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Fond de carte ---
# Tuiles relayées et mises en cache par l'API : {z}, {x}, {y}, et au besoin {s} et {r}.
# Par défaut, les tuiles d'OpenStreetMap (sans clé, pour les tests). En production, un
# fournisseur avec clé, par exemple CARTO :
#   MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=VOTRE_CLE
#   MAP_TILE_ATTRIBUTION="© OpenStreetMap © CARTO"
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="© contributeurs OpenStreetMap"
# Identification de l'appli auprès du fournisseur (exigée par OpenStreetMap)
MAP_TILE_USER_AGENT="HB/0.1 (+https://github.com/equationstratos/HB)"

# --- Attribution automatique ---
MATCHING_WAVE_SIZE=5
MATCHING_WAVE_TIMEOUT_SECONDS=120
MATCHING_SCHEDULED_WAVE_TIMEOUT_SECONDS=900
MATCHING_MAX_RADIUS_KM=30

# --- Surveillance ---
# Délai avant escalade en SOS d'un écart sans réponse de la cliente
DEVIATION_ESCALATION_SECONDS=120

# --- Gains des gardes (virements faits à la main par l'équipe en v1) ---
# Rémunération en centimes par heure (2000 = 20 €/h)
GUARD_HOURLY_RATE_CENTS=2000
# Durée minimale rémunérée par mission, en minutes
GUARD_MIN_BILLED_MINUTES=30
# Dépassement rémunéré au-delà du créneau réservé, en minutes : une mission oubliée
# « en cours » ne rapporte pas plus que son créneau + ce dépassement
GUARD_MAX_OVERTIME_MINUTES=30
# Montant minimal d'une demande de virement, en centimes (1000 = 10 €)
PAYOUT_MIN_CENTS=1000
