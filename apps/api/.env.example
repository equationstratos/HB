# --- Général ---
NODE_ENV=development
PORT=3000
# URL publique de l'API (liens, webhooks Twilio)
PUBLIC_URL=http://localhost:3000
# Origines autorisées (admin web), séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# --- Données ---
DATABASE_URL=postgresql://hb:hb@localhost:5432/hb
REDIS_URL=redis://localhost:6379

# --- Sécurité (à changer impérativement en production) ---
# Secret de signature des jetons JWT (64 caractères aléatoires minimum)
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me-change-me-1234
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Clé AES-256 en base64 (32 octets) pour chiffrer les secrets 2FA :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
THROTTLE_LIMIT_PER_MINUTE=120
AUTH_THROTTLE_LIMIT_PER_MINUTE=10

# --- Fournisseurs externes : "console" en développement (tout est journalisé) ---
SMS_PROVIDER=console
TELEPHONY_PROVIDER=console
PUSH_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EXPO_ACCESS_TOKEN=

# Itinéraires : straight (lignes droites), osrm ou ors (OpenRouteService)
ROUTING_PROVIDER=straight
OSRM_URL=https://routing.openstreetmap.de
ORS_API_KEY=

# Pièces justificatives : local ou s3
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=eu-west-3
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Attribution automatique ---
MATCHING_WAVE_SIZE=5
MATCHING_WAVE_TIMEOUT_SECONDS=120
MATCHING_SCHEDULED_WAVE_TIMEOUT_SECONDS=900
MATCHING_MAX_RADIUS_KM=30

# --- Surveillance ---
# Délai avant escalade en SOS d'un écart sans réponse de la cliente
DEVIATION_ESCALATION_SECONDS=120
