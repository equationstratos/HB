{
  "name": "hb",
  "private": true,
  "description": "Plateforme d'accompagnement furtif pour sécuriser les trajets des femmes",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "turbo": "^2.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "eslint-plugin-react-hooks": "^5.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "@nestjs/core",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}
